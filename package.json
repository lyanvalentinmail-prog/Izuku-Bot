{
  "name": "izuku-bot",
  "version": "2.0.0",
  "description": "Izuku Bot - Bot de WhatsApp multifuncion hecho con Baileys (QR y codigo de 8 digitos)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "qr": "node index.js --qr",
    "code": "node index.js --code",
