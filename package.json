    "file-type": "^19.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-cache": "^5.1.2",
    "node-webpmux": "^3.2.1",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "engines": {
    "node": ">=20"
  }
