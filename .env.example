# Contraseña para entrar al panel de control (OBLIGATORIA para usar el panel)
PANEL_PASSWORD=
# Puerto del panel (por defecto 3000). Render lo define solo.
PORT=3000
# Carpeta de datos persistentes (opcional). Ej: /data en Render. Vacio = dentro del proyecto.
DATA_DIR=

# Opcional: solo si quieres usar IA con tu propia API key
OPENAI_API_KEY=
GEMINI_API_KEY=
