# ===============================================
#  Variables de entorno (opcionales)
#  Copia este archivo como .env y ajusta lo que necesites.
# ===============================================

# ---- Panel web ----
# Clave para entrar al panel. Si la dejas vacía, el bot genera una
# y la muestra en los logs ("Clave del panel: ...").
PANEL_PASSWORD=

# Encender el panel web (true/false). En un servidor déjalo en true:
# es la forma de vincular el bot por QR o con código de 8 dígitos.
PANEL_ENABLED=true

# Puerto del panel. En Render/Heroku/etc. lo define la plataforma (PORT).
PORT=3000

# ---- Datos persistentes (Render, Railway, Docker con volumen) ----
# Carpeta base donde se guardan sesión, sub-bots y base de datos.
# En Render con disco: DATA_DIR=/var/data
DATA_DIR=

# O puedes apuntar cada cosa por separado:
# SESSION_DIR=/var/data/sessions
# SUBBOTS_DIR=/var/data/subbots
# DATABASE_DIR=/var/data/database
# TMP_DIR=/var/data/tmp

# ---- Zona horaria ----
TZ=America/Montevideo

# ---- IA (opcional: solo si quieres usar tus propias API keys) ----
OPENAI_API_KEY=
GEMINI_API_KEY=
